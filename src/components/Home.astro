---
import Layout from '../layouts/Layout.astro';
import ContactForm from './ContactForm.astro';
import { ui, linkedin, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].home;
---

<Layout title={t.title} lang={lang} page="home">
	<main>
		<!-- Hero -->
		<section class="hero container">
			<h1 class="reveal reveal-2">
				{t.h1a}<br />
				<span class="accent">{t.h1b}</span>
			</h1>
			<p class="hero-lead reveal reveal-3">{t.lead}</p>
			<div class="hero-actions reveal reveal-4">
				<a class="btn btn-primary" href="#kontakt">{t.cta} <span aria-hidden="true">→</span></a>
				<a class="btn btn-ghost" href="#stationen">{t.cta2}</a>
			</div>
		</section>

		<!-- Bild im leuchtenden Rahmen -->
		<div class="container">
			<figure class="hero-frame reveal reveal-4">
				<picture>
					<source media="(max-width: 600px)" srcset="/hero-bluemlisalp-mobil.webp" width="900" height="1125" />
					<img src="/hero-bluemlisalp.webp" width="2576" height="1203" alt={t.imgAlt} fetchpriority="high" />
				</picture>
				<figcaption>{t.imgCaption}</figcaption>
			</figure>
		</div>

		<!-- Kennzahlen -->
		<section class="stats container" aria-label={t.venturesEyebrow}>
			{
				t.stats.map((s) => (
					<div class="stat in-view">
						<p class="stat-value">{s.value}</p>
						<p class="stat-label">{s.label}</p>
					</div>
				))
			}
		</section>

		<!-- Was ich aufgebaut habe -->
		<section class="ventures container" id="stationen" aria-labelledby="stationen-titel">
			<p class="eyebrow in-view">{t.venturesEyebrow}</p>
			<h2 id="stationen-titel" class="in-view">{t.ventures}</h2>
			<div class="venture-grid">
				{
					t.venturesItems.map((v, i) => (
						<article class="card venture in-view">
							<div class="venture-top">
								<span class="venture-num">{String(i + 1).padStart(2, '0')}</span>
								<span class="venture-meta">
									{'exit' in v && <span class="venture-exit">{t.exitLabel}</span>}
									<span class:list={['venture-years', { 'is-current': !/\d/.test(v.years) }]}>{v.years}</span>
								</span>
							</div>
							<h3>
								{'url' in v ? (
									<a href={v.url} target="_blank" rel="noopener">
										{v.company} <span aria-hidden="true">↗</span>
									</a>
								) : (
									v.company
								)}
							</h3>
							<p class="venture-role">{v.role}</p>
							<p class="venture-text">{v.text}</p>
							{'partner' in v && (
								<a class="badge venture-badge" href="https://www.payrexx.com/?ref=s32026" target="_blank" rel="noopener">
									<span class="badge-dot" aria-hidden="true"></span>
									{t.partner}
									<span aria-hidden="true">↗</span>
								</a>
							)}
						</article>
					))
				}
			</div>
		</section>

		<!-- Kontakt -->
		<section class="contact container" id="kontakt" aria-labelledby="kontakt-titel">
			<div class="card contact-card in-view">
				<div class="contact-head">
					<p class="eyebrow">{t.contactEyebrow}</p>
					<h2 id="kontakt-titel">{t.h2a} <span class="accent">{t.h2b}</span></h2>
					<p class="contact-mail">
						<a href="mailto:office@schmidbusiness.com">office@schmidbusiness.com</a>
						<a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
					</p>
				</div>
				<ContactForm lang={lang} />
			</div>
		</section>
	</main>
</Layout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		padding-top: clamp(56px, 9vw, 120px);
		padding-bottom: clamp(40px, 5vw, 64px);
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 28px;
		padding: 8px 16px 8px 12px;
		border: 1px solid var(--line-2);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.03);
		color: var(--text-2);
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		transition: border-color 0.3s, color 0.3s;
	}

	.badge:hover {
		color: var(--text);
		border-color: rgba(20, 214, 168, 0.5);
	}

	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px rgba(20, 214, 168, 0.18);
	}

	h1 {
		margin: 0;
		max-width: 13em;
		font-size: clamp(46px, 7.4vw, 96px);
		font-weight: 700;
		line-height: 1.03;
		letter-spacing: -0.035em;
	}

	.hero-lead {
		margin: clamp(24px, 3vw, 36px) 0 0;
		max-width: 38em;
		font-size: clamp(18px, 1.6vw, 21px);
		line-height: 1.65;
		color: var(--text-2);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: clamp(28px, 3.5vw, 44px);
	}

	/* ---------- Bild ---------- */
	.hero-frame {
		position: relative;
		margin: clamp(24px, 4vw, 48px) 0 0;
		padding: 10px;
		border: 1px solid var(--line-2);
		border-radius: 28px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01));
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.02),
			-30px -20px 90px -30px rgba(20, 214, 168, 0.35),
			30px 30px 100px -30px rgba(58, 47, 214, 0.45);
	}

	.hero-frame img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2576 / 1203;
		object-fit: cover;
		object-position: 50% 50%;
		border-radius: 20px;
	}

	.hero-frame figcaption {
		position: absolute;
		left: 28px;
		bottom: 26px;
		padding: 8px 14px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 12px;
		background: rgba(6, 8, 14, 0.6);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		font-size: 13px;
		font-weight: 500;
		color: var(--text);
	}

	/* ---------- Kennzahlen ---------- */
	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		padding-top: clamp(48px, 6vw, 88px);
	}

	.stat {
		padding: 26px 28px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--card);
	}

	.stat-value {
		margin: 0 0 6px;
		font-size: clamp(32px, 3.4vw, 44px);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
		background: linear-gradient(135deg, #ffffff 30%, var(--accent));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.stat-label {
		margin: 0;
		font-size: 15px;
		line-height: 1.5;
		color: var(--muted);
	}

	/* ---------- Stationen ---------- */
	.ventures {
		padding-top: clamp(80px, 10vw, 136px);
	}

	h2 {
		margin: 0;
		font-size: clamp(34px, 4.4vw, 56px);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.03em;
	}

	.venture-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin-top: clamp(32px, 4vw, 52px);
	}

	.card {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--card);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.venture {
		display: flex;
		flex-direction: column;
		padding: 28px;
		transition: border-color 0.4s var(--ease), transform 0.4s var(--ease);
	}

	.venture:hover {
		border-color: rgba(20, 214, 168, 0.35);
		transform: translateY(-3px);
	}

	.venture-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 36px;
	}

	.venture-num {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: rgba(20, 214, 168, 0.1);
		border: 1px solid rgba(20, 214, 168, 0.3);
		color: var(--accent);
		font-size: 14px;
		font-weight: 600;
	}

	.venture-meta {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.venture-exit {
		padding: 3px 9px;
		border: 1px solid var(--line-2);
		border-radius: 999px;
		font-size: 11.5px;
		font-weight: 500;
		color: var(--text-2);
		white-space: nowrap;
	}

	.venture-years.is-current {
		color: var(--accent);
	}

	.venture-badge {
		align-self: flex-start;
		margin: 22px 0 0;
		font-size: 13px;
	}

	.venture-years {
		font-size: 13px;
		font-weight: 500;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.venture h3 {
		margin: 0;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.venture h3 a {
		text-decoration: none;
		transition: color 0.3s;
	}

	.venture h3 a:hover {
		color: var(--accent);
	}

	.venture h3 a span {
		font-size: 0.7em;
		color: var(--accent);
	}

	.venture-role {
		margin: 6px 0 18px;
		font-size: 14px;
		font-weight: 500;
		color: var(--accent);
	}

	.venture-text {
		margin: 0;
		font-size: 15.5px;
		line-height: 1.65;
		color: var(--text-2);
	}

	/* ---------- Kontakt ---------- */
	.contact {
		padding-top: clamp(80px, 10vw, 136px);
	}

	.contact-card {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: clamp(32px, 5vw, 72px);
		padding: clamp(28px, 4.5vw, 56px);
		box-shadow:
			-40px -30px 120px -60px rgba(20, 214, 168, 0.4),
			40px 40px 120px -60px rgba(58, 47, 214, 0.5);
	}

	.contact-head h2 .accent {
		display: block;
	}

	.contact-mail {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 28px 0 0;
		font-size: 16px;
	}

	.contact-mail a {
		color: var(--text-2);
		text-decoration: none;
		transition: color 0.3s;
	}

	.contact-mail a:hover {
		color: var(--accent);
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 900px) {
		.venture-grid,
		.stats {
			grid-template-columns: 1fr;
		}

		.contact-card {
			grid-template-columns: 1fr;
		}

		.hero-frame img {
			aspect-ratio: 16 / 10;
		}
	}

	@media (max-width: 560px) {
		.hero-actions .btn {
			width: 100%;
		}

		.hero-frame {
			padding: 6px;
			border-radius: 22px;
		}

		.hero-frame img {
			aspect-ratio: 4 / 5;
			border-radius: 16px;
		}

		.hero-frame figcaption {
			left: 16px;
			bottom: 14px;
			font-size: 12px;
		}

		.venture-top {
			margin-bottom: 24px;
		}
	}
</style>
