---
import Layout from '../layouts/Layout.astro';
import ContactForm from './ContactForm.astro';
import { ui, linkedin, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].home;

// Zeitachse der Stationen
const axisStart = 2004;
const axisEnd = new Date().getFullYear();
const span = axisEnd - axisStart;
const pos = (y: number) => ((y - axisStart) / span) * 100;
const ticks = [2004, 2008, 2012, 2016, 2020, 2024].filter((y) => y <= axisEnd);
const timeline = [...t.venturesItems].sort((a, b) => a.start - b.start);
---

<Layout title={t.title} lang={lang} page="home">
	<main>
		<!-- ================= HERO ================= -->
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-media">
				<img src="/hero-gipfel.webp" width="1100" height="784" alt={t.imgAlt} fetchpriority="high" />
			</div>
			<div class="hero-shade" aria-hidden="true"></div>
			<canvas class="hero-net" aria-hidden="true"></canvas>
			<div class="hero-grid" aria-hidden="true"></div>
			<div class="hero-scan" aria-hidden="true"></div>

			<div class="hud" aria-hidden="true">
				<span class="c c-tl"></span><span class="c c-tr"></span><span class="c c-bl"></span><span class="c c-br"></span>
				<span class="hud-read hud-tr mono">N 46°46′41″ · E 7°37′58″</span>
				<span class="hud-read hud-br mono">{t.scroll} <span class="hud-arrow">↓</span></span>
			</div>

			<div class="container hero-content">
				<p class="kicker mono reveal">
					<span class="pulse" aria-hidden="true"></span>
					{t.kicker}<span class="cursor" aria-hidden="true">_</span>
				</p>
				<h1 id="hero-title">
					<span class="sr-only">{t.h1a} {t.h1b}</span>
					<span class="line" aria-hidden="true"><span class="ghost">{t.h1a}</span><span class="live" data-type>{t.h1a}</span></span>
					<span class="line line-accent" aria-hidden="true"><span class="ghost">{t.h1b}</span><span class="live accent" data-scramble>{t.h1b}</span></span>
				</h1>
				<div class="hero-meta mono reveal reveal-4">
					<span>{t.metaLeft}</span>
					<span class="meta-line" aria-hidden="true"></span>
					<span>{t.metaRight}</span>
				</div>
			</div>
		</section>

		<!-- ================= ÜBER MICH ================= -->
		<section class="intro container" aria-labelledby="about-title">
			<p class="label mono in-view" id="about-title">
				<span class="label-num">[01]</span>
				<span class="label-rule" aria-hidden="true"></span>
				{t.about}
			</p>
			<div class="intro-body">
				<p class="lead in-view">{t.lead}</p>
				<a class="partner in-view" href="https://www.payrexx.com/?ref=s32026" target="_blank" rel="noopener">
					<span class="partner-tag mono">Partner</span>
					<span class="partner-text">{t.partner}</span>
					<span class="partner-arrow" aria-hidden="true">↗</span>
				</a>
			</div>
		</section>

		<!-- ================= STATIONEN ================= -->
		<section class="ventures container" aria-labelledby="stationen-titel">
			<p class="label mono in-view" id="stationen-titel">
				<span class="label-num">[02]</span>
				<span class="label-rule" aria-hidden="true"></span>
				{t.ventures}
			</p>

			<div class="ventures-body">
				<div class="timeline in-view" aria-hidden="true">
					<div class="tl-head mono">
						<span>{t.timelineLabel}</span>
						<span>{axisStart} → {axisEnd}</span>
					</div>
					<div class="tl-rows">
						{
							timeline.map((v, i) => (
								<div class="tl-row">
									<span class="tl-name">{v.company.replace(' AG', '')}</span>
									<div class="tl-track">
										<span
											class="tl-bar"
											style={`left:${pos(v.start)}%;width:${pos(v.end) - pos(v.start)}%;--d:${i * 0.18}s`}
										/>
									</div>
								</div>
							))
						}
						<div class="tl-axis">
							{
								ticks.map((y) => (
									<span class="tl-tick mono" style={`left:${pos(y)}%`}>
										{y}
									</span>
								))
							}
							<span class="tl-now mono" style="left:100%">{t.today}</span>
						</div>
						<span class="tl-now-line" style="left:100%"></span>
					</div>
				</div>

				<ol class="venture-list">
					{
						t.venturesItems.map((v) => (
							<li class="venture in-view">
								<span class="venture-years mono">{v.years}</span>
								<div class="venture-head">
									<h3>
										{'url' in v ? (
											<a href={v.url} target="_blank" rel="noopener">
												{v.company}
											</a>
										) : (
											v.company
										)}
									</h3>
									<span class="venture-role mono">{v.role}</span>
								</div>
								<p class="venture-text">{v.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- ================= KONTAKT ================= -->
		<section class="contact" id="kontakt" aria-labelledby="kontakt-titel">
			<div class="contact-media" aria-hidden="true">
				<img src="/huette-grat.webp" width="1200" height="900" alt="" loading="lazy" />
			</div>
			<div class="container contact-inner">
				<div class="contact-head">
					<p class="label mono in-view">
						<span class="label-num">[03]</span>
						<span class="label-rule" aria-hidden="true"></span>
						{t.contact}
					</p>
					<h2 id="kontakt-titel" class="in-view">{t.h2a} <span class="accent">{t.h2b}</span></h2>
					<div class="contact-links in-view">
						<a href="mailto:office@schmidbusiness.ch" class="mono">office@schmidbusiness.ch</a>
						<a href={linkedin} target="_blank" rel="noopener" class="mono">LinkedIn ↗</a>
					</div>
				</div>
				<div class="form-panel in-view">
					<div class="panel-bar mono" aria-hidden="true">
						<span class="dots"><i></i><i></i><i></i></span>
						<span>contact.form</span>
					</div>
					<div class="panel-body">
						<ContactForm lang={lang} />
					</div>
				</div>
			</div>
		</section>
	</main>
	<script is:inline>
		(function () {
			var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	
			/* ---------- Titel: tippen + entschlüsseln ---------- */
			var typeEl = document.querySelector('[data-type]');
			var scrEl = document.querySelector('[data-scramble]');
			if (typeEl && scrEl && !reduce) {
				var t1 = typeEl.textContent;
				var t2 = scrEl.textContent;
				var glyphs = '01<>/{}[]#=+*$%ABCDEF0123456789';
				typeEl.textContent = '';
				scrEl.textContent = '';
				typeEl.classList.add('typing');
	
				var i = 0;
				setTimeout(function typeNext() {
					i++;
					typeEl.textContent = t1.slice(0, i);
					if (i < t1.length) return setTimeout(typeNext, 55 + Math.random() * 45);
					setTimeout(function () {
						typeEl.classList.remove('typing');
						scramble();
					}, 260);
				}, 650);
	
				function scramble() {
					var start = performance.now();
					var dur = 1500;
					scrEl.classList.add('scrambling');
					(function frame(now) {
						var p = Math.min(1, (now - start) / dur);
						var shown = Math.floor(p * t2.length);
						var out = '';
						for (var k = 0; k < t2.length; k++) {
							var ch = t2[k];
							if (k < shown || ch === ' ') out += ch;
							else if (k < shown + 12) out += glyphs[(Math.random() * glyphs.length) | 0];
						}
						scrEl.textContent = out;
						if (p < 1) requestAnimationFrame(frame);
						else {
							scrEl.textContent = t2;
							scrEl.classList.remove('scrambling');
						}
					})(start);
				}
			}
	
			/* ---------- Datennetz ---------- */
			var cv = document.querySelector('.hero-net');
			if (!cv || !cv.getContext) return;
			var ctx = cv.getContext('2d');
			var hero = cv.parentElement;
			var W, H, dpr, nodes = [], mouse = { x: -9999, y: -9999 }, running = true;
			var GOLD = '201,172,116';
	
			function resize() {
				dpr = Math.min(window.devicePixelRatio || 1, 2);
				W = hero.clientWidth;
				H = hero.clientHeight;
				cv.width = W * dpr;
				cv.height = H * dpr;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				var n = Math.round(Math.min(90, (W * H) / 13000));
				nodes = [];
				for (var k = 0; k < n; k++) {
					nodes.push({
						x: Math.random() * W,
						y: Math.random() * H * 0.85,
						vx: (Math.random() - 0.5) * 0.22,
						vy: (Math.random() - 0.5) * 0.22,
						r: Math.random() < 0.12 ? 2 : 1.1,
						ph: Math.random() * Math.PI * 2
					});
				}
			}
	
			function draw(t) {
				ctx.clearRect(0, 0, W, H);
				var max = Math.min(170, W / 7);
				for (var a = 0; a < nodes.length; a++) {
					var p = nodes[a];
					if (!reduce) {
						p.x += p.vx;
						p.y += p.vy;
						if (p.x < 0 || p.x > W) p.vx *= -1;
						if (p.y < 0 || p.y > H * 0.9) p.vy *= -1;
					}
					for (var b = a + 1; b < nodes.length; b++) {
						var q = nodes[b];
						var dx = p.x - q.x, dy = p.y - q.y;
						var d = Math.sqrt(dx * dx + dy * dy);
						if (d < max) {
							ctx.strokeStyle = 'rgba(' + GOLD + ',' + (1 - d / max) * 0.5 + ')';
							ctx.lineWidth = 0.8;
							ctx.beginPath();
							ctx.moveTo(p.x, p.y);
							ctx.lineTo(q.x, q.y);
							ctx.stroke();
						}
					}
					var mx = p.x - mouse.x, my = p.y - mouse.y;
					var md = Math.sqrt(mx * mx + my * my);
					if (md < 220) {
						ctx.strokeStyle = 'rgba(' + GOLD + ',' + (1 - md / 220) * 0.55 + ')';
						ctx.beginPath();
						ctx.moveTo(p.x, p.y);
						ctx.lineTo(mouse.x, mouse.y);
						ctx.stroke();
					}
					var glow = 0.55 + 0.45 * Math.sin(t / 900 + p.ph);
					ctx.fillStyle = 'rgba(' + GOLD + ',' + (0.5 + glow * 0.5) + ')';
					ctx.beginPath();
					ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
					ctx.fill();
					if (p.r > 1.5) {
						ctx.fillStyle = 'rgba(' + GOLD + ',' + glow * 0.18 + ')';
						ctx.beginPath();
						ctx.arc(p.x, p.y, 7, 0, Math.PI * 2);
						ctx.fill();
					}
				}
			}
	
			function loop(t) {
				if (running) draw(t);
				if (!reduce) requestAnimationFrame(loop);
			}
	
			resize();
			window.addEventListener('resize', resize);
			hero.addEventListener('pointermove', function (e) {
				var r = hero.getBoundingClientRect();
				mouse.x = e.clientX - r.left;
				mouse.y = e.clientY - r.top;
			});
			hero.addEventListener('pointerleave', function () {
				mouse.x = mouse.y = -9999;
			});
			if ('IntersectionObserver' in window) {
				new IntersectionObserver(function (en) {
					running = en[0].isIntersecting;
				}).observe(hero);
			}
			if (reduce) draw(0);
			else {
				cv.style.opacity = '0';
				cv.style.transition = 'opacity 2s ease';
				requestAnimationFrame(function () {
					cv.style.opacity = '1';
				});
				requestAnimationFrame(loop);
			}
		})();
	</script>
</Layout>

<style>
	/* ================= HERO ================= */
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		isolation: isolate;
		background: var(--bg);
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: -4;
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 62%;
		filter: saturate(0.9) contrast(1.06) brightness(0.92);
	}

	.hero-shade {
		position: absolute;
		inset: 0;
		z-index: -3;
		background:
			linear-gradient(180deg, rgba(10, 10, 9, 0.7) 0%, rgba(10, 10, 9, 0) 22%),
			linear-gradient(90deg, rgba(10, 10, 9, 0.82) 0%, rgba(10, 10, 9, 0.35) 48%, rgba(10, 10, 9, 0.05) 100%),
			linear-gradient(0deg, var(--bg) 0%, rgba(10, 10, 9, 0.55) 28%, rgba(10, 10, 9, 0) 60%);
	}

	.hero-grid {
		position: absolute;
		inset: 0;
		z-index: -2;
		background-image:
			linear-gradient(rgba(243, 240, 234, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(243, 240, 234, 0.06) 1px, transparent 1px);
		background-size: 72px 72px;
		background-position: -1px -1px;
		mask-image: radial-gradient(ellipse 80% 70% at 70% 40%, #000 20%, transparent 75%);
		-webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 40%, #000 20%, transparent 75%);
	}

	.hero-scan {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 140px;
		z-index: -1;
		background: linear-gradient(180deg, transparent, rgba(201, 172, 116, 0.07) 70%, rgba(201, 172, 116, 0.5) 99%, transparent);
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-scan {
			animation: scan 7s 1.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
		}
		@keyframes scan {
			0% {
				transform: translateY(-140px);
				opacity: 0;
			}
			10% {
				opacity: 1;
			}
			70% {
				opacity: 0.8;
			}
			100% {
				transform: translateY(100svh);
				opacity: 0;
			}
		}
	}

	/* HUD-Ecken */
	.hud {
		position: absolute;
		inset: calc(var(--header-h) + 12px) clamp(12px, 2.4vw, 32px) clamp(16px, 2.4vw, 32px);
		pointer-events: none;
	}

	.c {
		position: absolute;
		width: 22px;
		height: 22px;
		border-color: rgba(201, 172, 116, 0.7);
		border-style: solid;
		border-width: 0;
	}

	.c-tl {
		top: 0;
		left: 0;
		border-top-width: 1px;
		border-left-width: 1px;
	}
	.c-tr {
		top: 0;
		right: 0;
		border-top-width: 1px;
		border-right-width: 1px;
	}
	.c-bl {
		bottom: 0;
		left: 0;
		border-bottom-width: 1px;
		border-left-width: 1px;
	}
	.c-br {
		bottom: 0;
		right: 0;
		border-bottom-width: 1px;
		border-right-width: 1px;
	}

	.hud-read {
		position: absolute;
		color: var(--ink-2);
		font-size: 10.5px;
	}

	.hud-tr {
		top: 6px;
		right: 36px;
	}

	.hud-br {
		bottom: 4px;
		right: 36px;
	}

	.hud-arrow {
		display: inline-block;
		color: var(--gold);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hud-arrow {
			animation: nudge 2s ease-in-out infinite;
		}
		@keyframes nudge {
			50% {
				transform: translateY(4px);
			}
		}
	}

	.hero-content {
		padding-top: calc(var(--header-h) + 80px);
		padding-bottom: clamp(64px, 11vh, 120px);
	}

	.kicker {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin: 0 0 clamp(20px, 3vw, 32px);
		color: var(--gold);
	}

	.pulse {
		position: relative;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--gold);
	}

	.pulse::after {
		content: '';
		position: absolute;
		inset: -5px;
		border-radius: 50%;
		border: 1px solid var(--gold);
		opacity: 0;
	}

	.cursor {
		margin-left: 2px;
		color: var(--ink);
	}

	@media (prefers-reduced-motion: no-preference) {
		.pulse::after {
			animation: ping 2.4s var(--ease) infinite;
		}
		.cursor {
			animation: blink 1.1s steps(1) infinite;
		}
		@keyframes ping {
			0% {
				transform: scale(0.4);
				opacity: 0.9;
			}
			100% {
				transform: scale(1.8);
				opacity: 0;
			}
		}
		@keyframes blink {
			50% {
				opacity: 0;
			}
		}
	}

	h1 {
		margin: 0;
		font-weight: 300;
		font-size: clamp(42px, 7.4vw, 112px);
		line-height: 0.98;
		letter-spacing: -0.045em;
		max-width: 11em;
		text-wrap: balance;
	}

	.accent {
		display: block;
		font-weight: 500;
		background: linear-gradient(90deg, #e6cf9d 0%, var(--gold) 45%, var(--gold-deep) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero-meta {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: clamp(28px, 4vw, 48px);
		max-width: 760px;
		color: var(--ink-2);
	}

	.meta-line {
		flex: 1;
		height: 1px;
		background: var(--line-2);
		position: relative;
		overflow: hidden;
	}

	.meta-line::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--gold);
		transform-origin: left;
		transform: scaleX(0);
	}

	@media (prefers-reduced-motion: no-preference) {
		.meta-line::after {
			animation: draw 1.8s 0.9s var(--ease) forwards;
		}
		.reveal {
			animation: reveal 1.2s var(--ease) both;
		}
		.reveal-2 {
			animation-delay: 0.15s;
		}
		.reveal-3 {
			animation-delay: 0.3s;
		}
		.hero-media img {
			animation: settle 2.6s var(--ease) both;
		}
		@keyframes reveal {
			from {
				opacity: 0;
				transform: translateY(16px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
		@keyframes settle {
			from {
				opacity: 0;
				transform: scale(1.06);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.meta-line::after {
			transform: scaleX(1);
		}
	}

	@keyframes draw {
		to {
			transform: scaleX(1);
		}
	}

	/* ---------- Animierter Titel ---------- */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.line {
		position: relative;
		display: block;
	}

	.ghost {
		visibility: hidden;
	}

	.live {
		position: absolute;
		inset: 0;
	}

	.line-accent .live {
		display: block;
	}

	.line:first-of-type .live::after {
		content: '';
	}

	.typing::after {
		content: '';
		display: inline-block;
		width: 0.06em;
		height: 0.82em;
		margin-left: 0.06em;
		vertical-align: -0.04em;
		background: var(--gold);
		box-shadow: 0 0 14px var(--gold);
	}

	.scrambling {
		text-shadow: none;
	}

	.reveal-4 {
		animation-delay: 2.3s !important;
	}

	/* ---------- Datennetz über dem Bild ---------- */
	.hero-net {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -2;
		pointer-events: none;
		mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.45) 30%, #000 60%);
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.45) 30%, #000 60%);
	}

	/* ================= LABELS ================= */
	.label {
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 0;
		color: var(--ink-2);
	}

	.label-num {
		color: var(--gold);
	}

	.label-rule {
		width: 32px;
		height: 1px;
		background: var(--gold);
	}

	/* ================= ÜBER MICH ================= */
	.intro,
	.ventures {
		display: grid;
		grid-template-columns: minmax(180px, 1fr) 2.6fr;
		gap: clamp(24px, 5vw, 80px);
	}

	.intro {
		padding-top: clamp(80px, 10vw, 150px);
		padding-bottom: clamp(72px, 9vw, 130px);
	}

	.intro .label,
	.ventures .label {
		align-self: start;
		padding-top: 0.75em;
	}

	.lead {
		margin: 0;
		font-weight: 300;
		font-size: clamp(24px, 2.9vw, 42px);
		line-height: 1.3;
		letter-spacing: -0.025em;
		color: var(--ink);
		text-wrap: pretty;
	}

	.partner {
