---
// ContactForm.astro – schlankes Kontaktformular, Versand über EmailJS
import { ui, routes, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const f = ui[lang].form;
const privacyHref = routes.privacy[lang];
const privacyLabel = ui[lang].privacy;
---

<form id="contact-form" class="contact-form" novalidate>
	<div class="row">
		<div class="field">
			<label for="cf-name">{f.name}</label>
			<input id="cf-name" name="name" type="text" autocomplete="name" required />
		</div>
		<div class="field">
			<label for="cf-email">{f.email}</label>
			<input id="cf-email" name="email" type="email" autocomplete="email" required />
		</div>
	</div>
	<div class="field">
		<label for="cf-message">{f.message}</label>
		<textarea id="cf-message" name="message" rows="5" required></textarea>
	</div>
	<div class="actions">
		<p class="consent">
			{f.consent} <a href={privacyHref}>{privacyLabel}</a>
		</p>
		<button id="submit-btn" type="submit"><span class="btn-label">{f.send}</span><span class="btn-arrow" aria-hidden="true">→</span></button>
	</div>
	<div id="form-status" class="status" role="status" aria-live="polite" hidden></div>
</form>

<style>
	.contact-form {
		display: grid;
		gap: 18px;
	}

	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px;
	}

	.field {
		display: grid;
		gap: 8px;
	}

	label {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-2);
	}

	input,
	textarea {
		width: 100%;
		font: inherit;
		font-size: 16px;
		color: var(--text);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--line-2);
		border-radius: 16px;
		padding: 15px 18px;
		transition: border-color 0.3s var(--ease), background 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}

	input::placeholder,
	textarea::placeholder {
		color: var(--muted);
	}

	textarea {
		resize: vertical;
		min-height: 150px;
		line-height: 1.5;
	}

	input:hover,
	textarea:hover {
		border-color: rgba(255, 255, 255, 0.28);
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--accent);
		background: rgba(255, 255, 255, 0.06);
		box-shadow: 0 0 0 4px rgba(20, 214, 168, 0.15);
	}

	.actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-top: 4px;
	}

	.consent {
		margin: 0;
		max-width: 24em;
		font-size: 13px;
		line-height: 1.55;
		color: var(--muted);
	}

	.consent a {
		color: var(--text-2);
		text-underline-offset: 3px;
	}

	button {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		font-family: var(--sans);
		font-size: 17px;
		font-weight: 600;
		color: var(--accent-ink);
		background: linear-gradient(135deg, #1ee0b2, #0bbd9b);
		border: 0;
		border-radius: 16px;
		padding: 17px 30px;
		cursor: pointer;
		box-shadow: 0 10px 30px rgba(20, 214, 168, 0.18);
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}

	.btn-arrow {
		transition: transform 0.3s var(--ease);
	}

	button:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 40px rgba(20, 214, 168, 0.32);
	}

	button:hover .btn-arrow {
		transform: translateX(3px);
	}

	button:disabled {
		opacity: 0.6;
		cursor: default;
		transform: none;
	}

	.status {
		font-size: 15px;
		line-height: 1.6;
		padding: 14px 16px;
		border-radius: 14px;
	}

	.status[data-kind='success'] {
		color: #b8f5e3;
		background: rgba(20, 214, 168, 0.1);
		border: 1px solid rgba(20, 214, 168, 0.35);
	}

	.status[data-kind='error'] {
		color: #ffc9c2;
		background: rgba(255, 90, 70, 0.08);
		border: 1px solid rgba(255, 90, 70, 0.3);
	}

	@media (max-width: 600px) {
		.row {
			grid-template-columns: 1fr;
		}

		.actions {
			flex-direction: column-reverse;
			align-items: stretch;
		}
	}
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4.4.1/dist/email.min.js"></script>
<script define:vars={{ f, lang }}>
	(function () {
		var form = document.getElementById('contact-form');
		var btn = document.getElementById('submit-btn');
		var statusBox = document.getElementById('form-status');
		if (!form || !btn) return;
		var label = btn.querySelector('.btn-label');

		if (window.emailjs) {
			emailjs.init({ publicKey: 'FQeBWdwkjiwk9aYxl' });
		}

		function showStatus(kind, text) {
			statusBox.textContent = text;
			statusBox.dataset.kind = kind;
			statusBox.hidden = false;
		}

		form.addEventListener('submit', function (e) {
			e.preventDefault();
			statusBox.hidden = true;

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			if (!window.emailjs) {
				showStatus('error', f.unavailable);
				return;
			}

			btn.disabled = true;
			label.textContent = f.sending;

			var params = {
				to_email: 'office@schmidbusiness.com',
				from_name: form.name.value.trim(),
				from_email: form.email.value.trim(),
				request: 'Kontaktformular schmidbusiness.com',
				message: form.message.value.trim(),
				language: lang === 'en' ? 'Englisch' : 'Deutsch',
				subject: 'Website Anfrage von schmidbusiness.com'
			};

			emailjs
				.send('service_mtfmush', 'template_ws51hqc', params)
				.then(function () {
					showStatus('success', f.success);
					form.reset();
				})
				.catch(function (err) {
					console.error('EmailJS:', err);
					showStatus('error', f.error);
				})
				.finally(function () {
					btn.disabled = false;
					label.textContent = f.send;
				});
		});
	})();
</script>
