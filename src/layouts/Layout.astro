---
import '@fontsource-variable/inter';
import Logo from '../components/Logo.astro';
import { ui, routes, linkedin, type Lang, type PageKey } from '../i18n';

interface Props {
	title: string;
	lang: Lang;
	page: PageKey;
	description?: string;
	noindex?: boolean;
}

const { title, lang, page, description, noindex = false } = Astro.props;
const t = ui[lang];
const desc = description ?? t.description;
const canonical = new URL(routes[page][lang], Astro.site).href;
const altDe = new URL(routes[page].de, Astro.site).href;
const altEn = new URL(routes[page].en, Astro.site).href;

// Schwebende Lichtpunkte im Hintergrund (feste Positionen, damit der Build stabil bleibt)
const dots = [
	[7, 12, 'a', 0], [14, 61, 'b', 3], [22, 34, 'a', 6], [31, 82, 'b', 1], [39, 18, 'a', 4],
	[46, 70, 'b', 7], [53, 42, 'a', 2], [61, 90, 'b', 5], [68, 25, 'a', 8], [76, 55, 'b', 0],
	[83, 8, 'a', 6], [89, 77, 'b', 3], [94, 38, 'a', 9], [11, 92, 'b', 4], [57, 5, 'a', 7],
	[27, 48, 'b', 2], [72, 66, 'a', 5], [35, 96, 'b', 8],
] as const;
---

<!doctype html>
<html lang={t.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={desc} />
		<meta name="author" content="Ivan Schmid" />
		<meta name="theme-color" content="#05060b" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="de-CH" href={altDe} />
		<link rel="alternate" hreflang="en" href={altEn} />
		<link rel="alternate" hreflang="x-default" href={altDe} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={desc} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={t.ogLocale} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/hero-bluemlisalp.webp', Astro.site).href} />
	</head>
	<body>
		<div class="backdrop" aria-hidden="true">
			<span class="glow glow-teal"></span>
			<span class="glow glow-indigo"></span>
			<span class="glow glow-teal-2"></span>
			{
				dots.map(([x, y, c, d]) => (
					<span class:list={['dot', `dot-${c}`]} style={`left:${x}%;top:${y}%;animation-delay:-${d}s`} />
				))
			}
		</div>

		<header class="site-header">
			<div class="container">
				<div class="header-inner">
					<a href={routes.home[lang]} aria-label={t.homeAria} class="header-logo"><Logo /></a>
					<div class="header-right">
						<nav class="lang-switch" aria-label={t.langLabel}>
							<a href={routes[page].de} hreflang="de" lang="de" aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
							<a href={routes[page].en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
						</nav>
						<a class="header-cta" href={routes.home[lang] + '#kontakt'}>
							{t.contactLink} <span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container">
				<div class="footer-grid">
					<div class="footer-col footer-brand">
						<Logo />
						<address>
							Schmid Business Solutions<br />
							Hardeggweg 2<br />
							3612 Steffisburg<br />
							{t.country}
						</address>
					</div>
					<div class="footer-col">
						<p class="footer-label">{t.footerContact}</p>
						<p>
							<a href="mailto:office@schmidbusiness.com">office@schmidbusiness.com</a><br />
							<a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
						</p>
					</div>
					<div class="footer-col">
						<p class="footer-label">UID</p>
						<p>CHE-199.237.913</p>
					</div>
				</div>
				<div class="footer-inner">
					<span>© {new Date().getFullYear()} Schmid Business Solutions</span>
					<nav aria-label={t.legalNav}>
						<a href={routes.imprint[lang]}>{t.imprint}</a>
						<a href={routes.privacy[lang]}>{t.privacy}</a>
						<a href={routes.terms[lang]}>{t.terms}</a>
					</nav>
				</div>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var header = document.querySelector('.site-header');
				function onScroll() {
					if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
				}
				onScroll();
				window.addEventListener('scroll', onScroll, { passive: true });

				var items = document.querySelectorAll('.in-view');
				var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!('IntersectionObserver' in window) || reduce) return;
				document.documentElement.classList.add('js-reveal');
				var io = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (e) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								io.unobserve(e.target);
							}
						});
					},
					{ rootMargin: '0px 0px -10% 0px' }
				);
				items.forEach(function (el) {
					io.observe(el);
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #05060b;
		--bg-2: #0a0c14;
		--card: rgba(15, 18, 28, 0.72);
		--card-solid: #0d1019;
		--line: rgba(255, 255, 255, 0.09);
		--line-2: rgba(255, 255, 255, 0.16);
		--text: #f3f5f7;
		--text-2: #b4bac3;
		--muted: #8a919c;
		--accent: #14d6a8;
		--accent-2: #0bbd9b;
		--accent-ink: #04140f;
		--indigo: #3a2fd6;
		--gold: #c9ac74;
		--sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--container: 1200px;
		--gutter: clamp(20px, 5vw, 56px);
		--radius: 20px;
		--ease: cubic-bezier(0.22, 0.61, 0.36, 1);
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
		background: var(--bg);
	}

	body {
		position: relative;
		margin: 0;
		background: transparent;
		color: var(--text);
		font-family: var(--sans);
		font-size: 17px;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	a {
		color: inherit;
	}

	::selection {
		background: rgba(20, 214, 168, 0.3);
	}

	.container {
		position: relative;
		width: 100%;
		max-width: var(--container);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.eyebrow {
		margin: 0 0 18px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.accent {
		color: var(--accent);
	}

	/* ---------- Animierter Hintergrund ---------- */
	.backdrop {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		background: var(--bg);
	}

	.glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(90px);
		opacity: 0.55;
		will-change: transform;
	}

	.glow-teal {
		width: 62vmax;
		height: 62vmax;
		left: -26vmax;
		top: -22vmax;
		background: radial-gradient(circle, rgba(13, 120, 104, 0.85), rgba(13, 120, 104, 0) 65%);
		animation: drift-a 26s ease-in-out infinite alternate;
	}

	.glow-indigo {
		width: 66vmax;
		height: 66vmax;
		right: -30vmax;
		bottom: -26vmax;
		background: radial-gradient(circle, rgba(46, 38, 190, 0.8), rgba(46, 38, 190, 0) 65%);
		animation: drift-b 32s ease-in-out infinite alternate;
	}

	.glow-teal-2 {
		width: 40vmax;
		height: 40vmax;
		right: 8vmax;
		top: 30vh;
		opacity: 0.25;
		background: radial-gradient(circle, rgba(20, 160, 190, 0.8), rgba(20, 160, 190, 0) 65%);
		animation: drift-c 22s ease-in-out infinite alternate;
	}

	.dot {
		position: absolute;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		opacity: 0.7;
		animation: float 10s ease-in-out infinite;
	}

	.dot-a {
		background: #18c7a0;
		box-shadow: 0 0 8px rgba(24, 199, 160, 0.8);
	}

	.dot-b {
		background: #4b3cf0;
		box-shadow: 0 0 8px rgba(75, 60, 240, 0.8);
	}

	@keyframes drift-a {
		0% { transform: translate(0, 0) scale(1); }
		50% { transform: translate(14vw, 10vh) scale(1.15); }
		100% { transform: translate(4vw, 26vh) scale(0.95); }
	}

	@keyframes drift-b {
		0% { transform: translate(0, 0) scale(1); }
		50% { transform: translate(-16vw, -12vh) scale(1.1); }
		100% { transform: translate(-6vw, -30vh) scale(1.2); }
	}

	@keyframes drift-c {
		0% { transform: translate(0, 0); }
		100% { transform: translate(-30vw, 20vh); }
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); opacity: 0.2; }
		50% { transform: translateY(-22px); opacity: 0.85; }
	}

	@media (prefers-reduced-motion: reduce) {
		.glow,
		.dot {
			animation: none;
		}
	}

	/* ---------- Header ---------- */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding-top: 16px;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 12px 12px 22px;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: rgba(8, 10, 16, 0.55);
		backdrop-filter: blur(16px) saturate(140%);
		-webkit-backdrop-filter: blur(16px) saturate(140%);
		transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
	}

	.is-scrolled .header-inner {
		background: rgba(8, 10, 16, 0.85);
		border-color: var(--line-2);
	}

	.site-header a {
		text-decoration: none;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.lang-switch {
		display: flex;
		gap: 2px;
		padding: 3px;
		border: 1px solid var(--line);
		border-radius: 12px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
	}

	.lang-switch a {
		padding: 6px 10px;
		border-radius: 9px;
		color: var(--muted);
		transition: color 0.3s, background 0.3s;
	}

	.lang-switch a:hover {
		color: var(--text);
	}

	.lang-switch a[aria-current] {
		color: var(--text);
		background: rgba(255, 255, 255, 0.08);
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 11px 20px;
		border-radius: 14px;
		background: #fff;
		color: #07080c;
		font-size: 15px;
		font-weight: 600;
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}

	.header-cta:hover {
		transform: translateY(-1px);
		box-shadow: 0 8px 24px rgba(255, 255, 255, 0.12);
	}

	/* ---------- Buttons ---------- */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 17px 30px;
		border-radius: 16px;
		font-family: var(--sans);
		font-size: 17px;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid transparent;
		cursor: pointer;
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), background 0.3s, border-color 0.3s;
	}

	.btn-primary {
		color: var(--accent-ink);
		background: linear-gradient(135deg, #1ee0b2, #0bbd9b);
		box-shadow: 0 10px 30px rgba(20, 214, 168, 0.18);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 40px rgba(20, 214, 168, 0.32);
	}

	.btn-ghost {
		color: var(--text);
		background: rgba(255, 255, 255, 0.02);
		border-color: var(--line-2);
	}

	.btn-ghost:hover {
		border-color: rgba(255, 255, 255, 0.35);
		background: rgba(255, 255, 255, 0.05);
	}

	.btn span[aria-hidden] {
		transition: transform 0.3s var(--ease);
	}

	.btn:hover span[aria-hidden] {
		transform: translateX(3px);
	}

	/* ---------- Footer ---------- */
	.site-footer {
		position: relative;
		margin-top: clamp(40px, 6vw, 80px);
		color: var(--muted);
		font-size: 15px;
		line-height: 1.75;
		border-top: 1px solid var(--line);
		background: rgba(5, 6, 11, 0.6);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr;
		gap: 32px 48px;
		padding-top: clamp(40px, 5vw, 64px);
		padding-bottom: clamp(32px, 4vw, 48px);
	}

	.footer-col p,
	.footer-col address {
		margin: 0;
		font-style: normal;
	}

	.footer-brand address {
		margin-top: 20px;
	}

	.footer-label {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 12px !important;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		justify-content: space-between;
		padding-top: 22px;
		padding-bottom: 30px;
		border-top: 1px solid var(--line);
		font-size: 14px;
	}

	.site-footer nav {
		display: flex;
		gap: 24px;
	}

	.site-footer a {
		text-decoration: none;
		transition: color 0.3s;
	}

	.site-footer a:hover {
		color: var(--text);
	}

	/* ---------- Einblenden ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.reveal {
			animation: reveal 1.1s var(--ease) both;
		}
		.reveal-2 {
			animation-delay: 0.12s;
		}
		.reveal-3 {
			animation-delay: 0.24s;
		}
		.reveal-4 {
			animation-delay: 0.36s;
		}
		@keyframes reveal {
			from {
				opacity: 0;
				transform: translateY(18px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
	}

	.js-reveal .in-view {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 1s var(--ease), transform 1s var(--ease);
	}

	.js-reveal .in-view.is-visible {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 760px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 560px) {
		.site-header {
			padding-top: 10px;
		}

		.header-inner {
			padding: 10px 10px 10px 16px;
			border-radius: 18px;
		}

		.header-cta {
			padding: 10px 14px;
			font-size: 14px;
		}

		.lang-switch a {
			padding: 5px 8px;
		}
	}
</style>
