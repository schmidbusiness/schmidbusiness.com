---
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import Logo from '../components/Logo.astro';
import { ui, routes, linkedin, type Lang, type PageKey } from '../i18n';

interface Props {
	title: string;
	lang: Lang;
	page: PageKey;
	description?: string;
	noindex?: boolean;
}

const { title, lang, page, description, noindex = false } = Astro.props;
const t = ui[lang];
const desc = description ?? t.description;
const canonical = new URL(routes[page][lang], Astro.site).href;
const altDe = new URL(routes[page].de, Astro.site).href;
const altEn = new URL(routes[page].en, Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={desc} />
		<meta name="author" content="Ivan Schmid" />
		<meta name="theme-color" content="#0a0a09" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="de-CH" href={altDe} />
		<link rel="alternate" hreflang="en" href={altEn} />
		<link rel="alternate" hreflang="x-default" href={altDe} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={desc} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={t.ogLocale} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/hero-gipfel.webp', Astro.site).href} />
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<div class="header-inner">
					<a href={routes.home[lang]} aria-label={t.homeAria}><Logo /></a>
					<div class="header-right">
						<nav class="lang-switch" aria-label={t.langLabel}>
							<a href={routes[page].de} hreflang="de" lang="de" aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
							<span aria-hidden="true">/</span>
							<a href={routes[page].en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
						</nav>
						<a class="header-link" href={routes.home[lang] + '#kontakt'}>{t.contactLink}</a>
					</div>
				</div>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container">
				<div class="footer-grid">
					<div class="footer-col">
						<p class="footer-name">Schmid Business Solutions</p>
						<address>
							Hardeggweg 2<br />
							3612 Steffisburg<br />
							{t.country}
						</address>
					</div>
					<div class="footer-col">
						<p class="footer-label">{t.footerContact}</p>
						<p>
							<a href="mailto:office@schmidbusiness.ch">office@schmidbusiness.ch</a><br />
							<a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
						</p>
					</div>
					<div class="footer-col">
						<p class="footer-label">UID</p>
						<p>CHE-199.237.913</p>
					</div>
				</div>
				<div class="footer-inner">
					<span>© {new Date().getFullYear()} Schmid Business Solutions · Steffisburg · CH</span>
					<nav aria-label={t.legalNav}>
						<a href={routes.imprint[lang]}>{t.imprint}</a>
						<a href={routes.privacy[lang]}>{t.privacy}</a>
						<a href={routes.terms[lang]}>{t.terms}</a>
					</nav>
				</div>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var header = document.querySelector('.site-header');
				function onScroll() {
					if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
				}
				onScroll();
				window.addEventListener('scroll', onScroll, { passive: true });

				var items = document.querySelectorAll('.in-view');
				var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!('IntersectionObserver' in window) || reduce) return;
				document.documentElement.classList.add('js-reveal');
				var io = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (e) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								io.unobserve(e.target);
							}
						});
					},
					{ rootMargin: '0px 0px -12% 0px' }
				);
				items.forEach(function (el) {
					io.observe(el);
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0a0a09;
		--bg-2: #111110;
		--bg-3: #171715;
		--ink: #f3f0ea;
		--ink-2: rgba(243, 240, 234, 0.72);
		--muted: rgba(243, 240, 234, 0.46);
		--line: rgba(243, 240, 234, 0.1);
		--line-2: rgba(243, 240, 234, 0.18);
		--gold: #c9ac74;
		--gold-deep: #a8874a;
		--gold-glow: rgba(201, 172, 116, 0.35);
		--dark: #0a0a09;
		--dark-line: rgba(255, 255, 255, 0.1);
		--sans: 'Manrope Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
		--container: 1280px;
		--gutter: clamp(20px, 5vw, 64px);
		--header-h: 84px;
		--ease: cubic-bezier(0.22, 0.61, 0.36, 1);
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
		background: var(--bg);
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 16px;
		font-weight: 400;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	a {
		color: inherit;
	}

	::selection {
		background: var(--gold-glow);
		color: #fff;
	}

	.container {
		width: 100%;
		max-width: var(--container);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.mono {
		font-family: var(--mono);
		font-size: 11.5px;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* ---------- Header ---------- */
	.site-header {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 30;
		transition: background 0.5s var(--ease), backdrop-filter 0.5s var(--ease);
	}

	.site-header.is-scrolled {
		background: rgba(10, 10, 9, 0.78);
		backdrop-filter: blur(16px) saturate(140%);
		-webkit-backdrop-filter: blur(16px) saturate(140%);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--header-h);
		border-bottom: 1px solid transparent;
		transition: height 0.5s var(--ease), border-color 0.5s var(--ease);
	}

	.is-scrolled .header-inner {
		height: 68px;
		border-bottom-color: var(--line);
	}

	.site-header a {
		text-decoration: none;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: clamp(18px, 3vw, 36px);
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 2px;
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		border: 1px solid var(--line-2);
		padding: 3px;
	}

	.lang-switch span {
		display: none;
	}

	.lang-switch a {
		padding: 3px 8px;
		color: var(--muted);
		transition: color 0.3s var(--ease), background 0.3s var(--ease);
	}

	.lang-switch a:hover {
		color: var(--ink);
	}

	.lang-switch a[aria-current] {
		color: var(--bg);
		background: var(--gold);
	}

	.header-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--mono);
		font-size: 11.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 9px 16px;
		border: 1px solid rgba(201, 172, 116, 0.5);
		color: var(--gold);
		transition: background 0.35s var(--ease), color 0.35s var(--ease);
	}

	.header-link::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--gold);
		box-shadow: 0 0 10px var(--gold);
	}

	.header-link:hover {
		background: var(--gold);
		color: var(--bg);
	}

	.header-link:hover::before {
		background: var(--bg);
		box-shadow: none;
	}

	/* ---------- Reveal ---------- */
	.js-reveal .in-view {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 1s var(--ease), transform 1s var(--ease);
	}

	.js-reveal .in-view.is-visible {
		opacity: 1;
		transform: none;
	}

	.js-reveal .in-view + .in-view {
		transition-delay: 0.1s;
	}

	/* ---------- Footer ---------- */
	.site-footer {
		position: relative;
		background: var(--bg);
		color: var(--ink-2);
		font-size: 14.5px;
		line-height: 1.75;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 32px 48px;
		padding-top: clamp(40px, 5vw, 56px);
		padding-bottom: clamp(32px, 4vw, 44px);
		border-top: 1px solid var(--line);
	}

	.footer-col p,
	.footer-col address {
		margin: 0;
		font-style: normal;
	}

	.footer-name {
		font-size: 17px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		margin-bottom: 10px !important;
	}

	.footer-label {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gold);
		margin-bottom: 12px !important;
	}

	.footer-label::before {
		content: '// ';
		color: var(--muted);
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 14px 32px;
		justify-content: space-between;
		padding-top: 22px;
		padding-bottom: 30px;
		border-top: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.site-footer nav {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
	}

	.site-footer a {
		text-decoration: none;
		transition: color 0.3s;
	}

	.site-footer a:hover {
		color: var(--gold);
	}

	@media (max-width: 760px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer-grid .footer-col:first-child {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 560px) {
		:root {
			--header-h: 68px;
		}

		.header-link {
			padding: 8px 12px;
		}
	}
</style>
